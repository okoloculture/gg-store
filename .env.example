PORT=3210
ADMIN_TOKEN=dev-admin-token

# Движок БД: sqlite (по умолчанию локально) или postgres.
# Если задан DATABASE_URL, postgres выбирается автоматически.
DB_DRIVER=sqlite
DB_PATH=./data/store.db
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# PG_MAX_CONNECTIONS=5
# PG_STATEMENT_TIMEOUT_MS=15000

# доли сбоев заглушек-поставщиков (0..1)
PROVIDER_A_FAIL_RATE=0.25
PROVIDER_A_TIMEOUT_RATE=0.15
PROVIDER_B_FAIL_RATE=0.10
PROVIDER_B_TIMEOUT_RATE=0.05
PROVIDER_TIMEOUT_MS=1500
# сколько заглушка "висит" после списания кода, изображая потерянный ответ
PROVIDER_HANG_MS=60000

# Serverless (Vercel). Проставляется платформой, локально нужно только для отладки.
# SERVERLESS=1
# PUBLIC_BASE_URL=https://example.vercel.app
# CRON_SECRET=...
